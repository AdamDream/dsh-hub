# ── 2026-09-20 文档整理（Track D）：规则随目录重构同步（原路径 → 新路径）
#    .workspace/repos/                          -> .workspace/workstreams/research/repos/
#    .workspace/research-dsh-workerspace/repos/ -> .workspace/workstreams/research/research-dsh-workerspace/repos/
#    .workspace/tmp-ppt-research/               -> .workspace/workstreams/research/tmp-ppt-research/
#    .workspace/research/{tarballs,tgz}/        -> .workspace/workstreams/research/research/{tarballs,tgz}/
#    .workspace/deploy-pptmaster/skills/        -> .workspace/workstreams/deploy/deploy-pptmaster/skills/
#    .workspace/upstream-015-diff/pkgs/         -> .workspace/workstreams/upstream-015-diff/pkgs/
#    .workspace/backup-*/                       -> .workspace/backups/
#    .workspace/deploy-lag/backup-*/            -> .workspace/workstreams/deploy/deploy-lag/backup-*/
#    .workspace/deploy-lag/sim/                 -> .workspace/workstreams/deploy/deploy-lag/sim/
#    .workspace/research-luxweft-doc/           -> .workspace/workstreams/research/research-luxweft-doc/
#    .workspace/deploy-pptmaster/.venv-ppt-test/-> .workspace/workstreams/deploy/deploy-pptmaster/.venv-ppt-test/


{
  "name": "@local/dsh-wallpaper",
  "version": "0.5.0",
  "description": "Static image wallpaper for DeepSeek Harness: per-page overrides, dark mask, URL/path/upload sources, persisted in settings.yaml. Fork of @frog755/dsh-wallpaper (MIT).",
  "license": "MIT",
  "author": "Frog755 (upstream @frog755/dsh-wallpaper)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frog755/dsh-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/Frog755/dsh-wallpaper/issues"
  },
  "homepage": "https://github.com/Frog755/dsh-wallpaper#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "background",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <0.2.0"
  }
}

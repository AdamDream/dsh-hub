{
  "name": "@local/dsh-usage",
  "version": "0.1.0",
  "description": "Token usage statistics for DeepSeek Harness (dsh + Claude Code dual source, non-billing) — settings-card dashboard with self-drawn SVG charts, zero runtime dependencies.",
  "license": "MIT",
  "author": "CNS2026495165",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "tokens",
    "statistics",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}

		const second = text.indexOf(edit.find, first + 1);
		if (second !== -1) throw new Error(`${label}/${edit.key}: anchor NOT UNIQUE (${countOccurrences(source, edit.find)} occurrences in source)`);
		text = text.slice(0, first) + edit.replace + text.slice(first + edit.find.length);
	}
	return text;
}

/** Count non-overlapping occurrences of a literal in a string. */
export function countOccurrences(haystack, needle) {
	let count = 0;
	let at = haystack.indexOf(needle);
	while (at !== -1) {
		count += 1;
		at = haystack.indexOf(needle, at + needle.length);
	}
	return count;
}

/**
 * Identifiers introduced at module scope by an edit group. The verifier asserts that
 * each one is DECLARED somewhere in the patched file (audit requirement: "引入标识符
 * 本文件内声明校验") and that it is actually referenced, so a rename cannot silently
 * produce a reference to something the module never declares.
 */
export const INTRODUCED = {
	layout: [
		"themePresenterSlots",
		"themeColorRefreshQueue",
		"themeColorFrame",
		"scheduleThemeColorRefresh",
		"acquireThemePresenter",
		"tokenSignature"
	],
	uitheme: ["sameOverrideTokens"],
	wallpaper: ["shadedTokens", "sameShadedTokens"]
};

export function introducedFor(scope) {
	const out = {};
	const layout = [];
	if (scope.includes("instances") || scope.includes("themeColor")) {
		/* the frame-coalesced refresh is (ii); (0) only changes who owns the presenter. */
		layout.push("themeColorRefreshQueue", "themeColorFrame", "scheduleThemeColorRefresh");
	}
	if (scope.includes("instances")) layout.push("themePresenterSlots", "acquireThemePresenter");
	if (scope.includes("signature")) layout.push("tokenSignature");
	if (layout.length > 0) out.layout = layout;
	if (scope.includes("overlay")) out.uitheme = INTRODUCED.uitheme;
	if (scope.includes("wallpaperShade")) out.wallpaper = INTRODUCED.wallpaper;
	return out;
}

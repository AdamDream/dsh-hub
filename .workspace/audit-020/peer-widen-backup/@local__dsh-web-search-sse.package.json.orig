{
  "name": "@local/dsh-web-search-sse",
  "version": "0.1.0",
  "private": true,
  "description": "SSE-tolerant Anthropic-Messages web search provider for the DSH web seam. Vendored from @deepseek-ai/dsh-web-search-deepseek, adding streaming (text/event-stream) response assembly so gateways that force SSE for server-side web_search tool requests keep working.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2"
  }
}

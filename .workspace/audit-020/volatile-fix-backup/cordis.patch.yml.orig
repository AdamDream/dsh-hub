# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- insert:
    - id: vision-adam
      name: '@deepseek-ai/dsh-vision-adam'

# 默认 agent preset 换成用户自建的 standard-glm（$DSH_HOME/.agent-presets/）：
# 与官方 standard 唯一区别是 subagent / subagent_fork 的 agentOptions 固定
# provider=adam、model=deepseek-v4-pro。
# 组合变更的生效面（2026-09-17 源码核实修正，原文"需重启 DSH 后对新会话生效"是误解）：
# `mount()` 只在**会话创建**时调用，而 `ensureStanding` 内有 compositionStamp
# (mtimeMs+size) 重挂载检查 → **改动后新建的会话本来就能拿到新组合**；
# 保持原代际的是"改动前已存在的会话及其子代理"（子代理走 composeFrom 复用父代）。
# 要热换子代理模型请走 settings 段 `dsh-subagent:` / 设置页，而不是改 preset 文件。
- id: agent-preset-registry
  config:
    default: standard-glm
- insert:
    - id: taste
      name: '@deepseek-ai/dsh-taste'
- insert:
    - id: btw
      name: '@local/dsh-btw'

# 壁纸插件（@frog755/dsh-wallpaper 的本地 fork，静态图片版）：
# per-page 覆盖 + 暗色遮罩 + URL/路径/上传来源，配置走 ~/.dsh/settings.yaml。
- insert:
    - id: wallpaper
      name: '@local/dsh-wallpaper'
# usage 插件（token 用量统计，web2 同款 @local/dsh-usage v0.1.0）；settings 命名空间 dsh-usage 由插件自注册（空 schema），无需 profile 配置
- insert:
    - id: usage
      name: '@local/dsh-usage'

# session-board 插件（会话状态看板 v0.1.0）；settings 命名空间 session-status-board 由插件自注册（默认 enabled=true / maxBoardTokens=500），无需 profile 配置
- insert:
    - id: session-status-board
      name: '@deepseek-ai/dsh-session-board'

# ---- dsh-workspace-enhancement 底座（SSH 远程开发 + 多工作区）——insert-only，未 disable 官方缝 ----
- insert:
    # ctx.ssh / ctx.subprocess / ctx.fs 三个远程 provider（占位连接，懒建立）
    - id: ssh-remote
      name: dsh-workspace-enhancement
      config:
        host: 127.0.0.1
        port: 22
        username: ssh
        cwd: /tmp
- insert:
    # 本机/远程目录 browse 后端
    - id: directory-picker-ssh
      name: dsh-workspace-enhancement/picker
      config:
        maxEntries: 1000
- insert:
    # 多连接注册表 + /dsw RPC
    - id: ssh-web-channel
      name: dsh-workspace-enhancement/web
      config:
        maxEntries: 1000
# ---- dsh-workerspace 薄插件（串口 + 烧录白名单）----
- insert:
    - id: workerspace
      name: '@local/dsh-workerspace'
- insert:
    - id: dsh-pptmaster
      name: '@local/dsh-pptmaster'
      config:
        root: !!js dshHomePath('office-ppt')
- id: directory-picker
  disabled: true
- insert:
    - id: directory-picker-browse
      name: '@deepseek-ai/dsh-host-directory-picker-browse'

# 禁用 dsh-workspace-enhancement 的 SSH 目录选择器，避免与 browse 后端重复注册 directoryPicker
- id: directory-picker-ssh
  disabled: true

# ---- dsh-ssh-gui（原生 SSH 连接 GUI 薄插件）----
- insert:
    - id: ssh-gui
      name: '@local/dsh-ssh-gui'

# dsh-subagent-model（子代理默认模型）：0.2.0 起 settings 命名空间 = **profile 条目 id**，
# 故条目 id 必须为 `subagent-model`（插件内 ENTRY_ID 与之对应）。
# 消费侧：dsh-tool-subagent 的本地补丁在每次派发时读 `settings.describe()` 里该 id 的实时 value，
# 用非空 provider/model 覆盖 preset 静态 agentOptions ⇒ 改值即热生效。
# 留空（不写 config）即沿用插件默认 adam/deepseek-v4-pro。
- insert:
    - id: subagent-model
      name: '@local/dsh-subagent-model'
      config:
        provider: adam
        model: deepseek-v4-pro

# ---- U-LD1：宿主日志文件出口（热①挂载；w20 audit §2.3 W-1 / §5 C1）----
# 唯一作用：注册一个**声明了 levels 的文件 exporter**，把 warn/info/error 落进有界 JSONL。
# 回滚：删掉下面这一条 insert（热面，秒级）或跑 apply-LogDrift-v1.mjs --rollback=U-LD1
- insert:
    - id: logfile
      name: '@local/dsh-logfile'
      config:
        level: 2 # 必须显式：2 = error+info+warn（3 才含 debug）；不写就等于被级别过滤丢弃
        maxBytes: 8388608 # 单文件上限 8 MiB
        maxFiles: 3 # 保留 <file> + .1 + .2 ⇒ 硬顶 24 MiB
        orphanWatch: true # U-LD2 巡检开关（独立回滚：置 false）

# ---- web_search SSE 兼容层（本地插件 @local/dsh-web-search-sse）----
# 目的：某些 Anthropic 兼容网关（实测 llmapi.roboscience.xyz / New API）在请求体带上
# server-side 工具 web_search_20250305 时**强制返回 text/event-stream 且忽略 stream:false**，
# 而官方 @deepseek-ai/dsh-web-search-deepseek 无条件 response.json() ⇒ 报
# "unexpected token 'e', \"event: mes\"..." 。本插件为官方实现的派生物，只新增 SSE 组装，
# 其余（请求形状/凭据解析/结果映射）与官方一致，provider id 为 deepseek-sse。
# 回滚：删除下面两条 insert/override，并把 searchProvider 改回 deepseek-official。
- insert:
    - id: web-search-sse
      name: '@local/dsh-web-search-sse'
      config:
        apiKeyEnv: DEEPSEEK_API_KEY
        baseURL: https://llmapi.roboscience.xyz/v1
        model: claude-opus-4-6
        maxUses: 100000

- id: ui-settings-general
  config:
    welcomeNoticeVersion: 2026-09-28.1

